# Foundation v1 configuration reference. Copy into an ignored env file and fill locally.
# These settings select the FUTURE production bootstrap; the legacy SQLite app rejects it.
RELAY_PROFILE=production
NODE_ENV=production
ENGINE_ROLE=api
HOST=0.0.0.0
PORT=4311
PUBLIC_ORIGIN=https://relay.example.com
COOKIE_SECURE=true
ALLOW_PRIVATE_NETWORK=false
# Restricted app role (not a superuser, BYPASSRLS role or table owner):
# DATABASE_URL=postgresql://APP_USER:REPLACE_LOCALLY@DB_HOST:5432/relay
# Owner/migrator credentials used ONLY for explicit migration command:
# MIGRATION_DATABASE_URL=postgresql://MIGRATOR:REPLACE_LOCALLY@DB_HOST:5432/relay
# Configure Redis AOF/persistence and noeviction; namespace each environment:
# REDIS_URL=rediss://:REPLACE_LOCALLY@REDIS_HOST:6379/0
QUEUE_PREFIX=relay
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
WORKER_CAPACITY=8
SHUTDOWN_TIMEOUT_MS=30000
# Generate a persistent 32-byte key; keep backups/key rotation material private.
# ENCRYPTION_KEY=<64 hex characters filled locally>
ENCRYPTION_KEY_ID=primary
# Qualification only: disposable services, never live private data:
# FOUNDATION_TEST_DATABASE_URL=postgresql://TEST_ADMIN:REPLACE_LOCALLY@localhost:5432/relay_foundation_test
# FOUNDATION_TEST_REDIS_URL=redis://localhost:6379/0
