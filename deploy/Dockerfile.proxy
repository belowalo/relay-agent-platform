FROM caddy:2-alpine@sha256:d44355d3c2149dc580ce2cac735955d1c08d3d00882c30489c241aa51a5c10d9
# Caddy ships a file capability; exec fails when bounding capabilities are ALL dropped.
# This proxy listens on 8443 and needs no privileged-port capability.
RUN setcap -r /usr/bin/caddy && chown -R 1000:1000 /data /config
USER 1000:1000
