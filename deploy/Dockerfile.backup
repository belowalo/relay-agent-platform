FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS node
FROM postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
RUN apk upgrade --no-cache && apk add --no-cache libstdc++ && rm -f /usr/local/bin/gosu /usr/local/bin/su-exec
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY bin/backup.mjs bin/backup.mjs
COPY server/observability/s3.js server/observability/s3.js
USER postgres
ENTRYPOINT ["node", "bin/backup.mjs"]
