FROM golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS build
RUN apk add --no-cache git
ADD https://github.com/prometheus/alertmanager.git#73c6bfe7393929211294c1954f30d8ed78e4d0ad /src
WORKDIR /src
# The pinned upstream image still links the vulnerable gRPC 1.83.1 module.
RUN go get google.golang.org/grpc@v1.83.2 && CGO_ENABLED=0 go build -trimpath -o /out/alertmanager ./cmd/alertmanager && CGO_ENABLED=0 go build -trimpath -o /out/amtool ./cmd/amtool
FROM prom/alertmanager@sha256:e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a
COPY --from=build /out/alertmanager /bin/alertmanager
COPY --from=build /out/amtool /bin/amtool
