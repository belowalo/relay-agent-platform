PORT=4311
DATA_DIR=./data
# Set a persistent 64-character hex key in production. Local development creates data/vault.key.
# ENCRYPTION_KEY=
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://relay.example.com
# ALLOW_PRIVATE_NETWORK=false

# Execution: embedded (default) or api; separate workers share the SAME local data directory.
# ENGINE_ROLE=embedded
# WORKER_CAPACITY=24
# WORKER_NAME=worker-1
# WORKER_LEASE_MS=5000
# Optional shared local embedding model cache; first semantic indexing downloads model weights.
# EMBEDDING_CACHE_DIR=./data/models
# Organization sign-in (OIDC authorization code + PKCE; HTTPS required in production)
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_EMAIL_DOMAINS=example.com
# SMTP enables password-recovery email; requires PUBLIC_ORIGIN above.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=relay@example.com
# SMTP_USER=
# SMTP_PASSWORD=
