{
  "name": "relay-agent-platform",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write src server/*.js server/foundation server/runtime server/security server/knowledge server/connectors tests sdk/javascript/*.mjs bin/*.mjs vite.config.ts playwright.config.ts README.md CONTRIBUTING.md SECURITY.md docs/*.md docs/production .github/workflows/*.yml",
    "format:check": "prettier --check src server/*.js server/foundation server/runtime server/security server/knowledge server/connectors tests sdk/javascript/*.mjs bin/*.mjs vite.config.ts playwright.config.ts README.md CONTRIBUTING.md SECURITY.md docs/*.md docs/production .github/workflows/*.yml",
    "worker": "node server/worker.js",
    "start:api": "node server/index.js",
    "foundation:config": "node bin/foundation.mjs config",
    "foundation:migrate": "node bin/foundation.mjs migrate",
    "foundation:probe": "node bin/foundation.mjs probe",
    "foundation:types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck server/foundation/ports.d.ts",
    "test:foundation": "node --test tests/foundation.test.js",
    "test:services": "node bin/test-services.mjs",
    "test:connectors": "node --test tests/connectors.test.js tests/connector-models.test.js tests/connector-mcp.test.js tests/connector-postgres.test.js tests/connector-routes.test.js",
    "connectors:probe": "node bin/connector-probe.mjs",
    "connectors:types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck server/connectors/ports.d.ts",
    "test:knowledge": "node --test --test-concurrency=1 tests/production-knowledge.test.js tests/knowledge-pglite.test.js",
    "test:knowledge:services": "node bin/knowledge-services.mjs",
    "knowledge:eval": "node bin/knowledge-evaluate.mjs",
    "knowledge:capacity": "node bin/knowledge-capacity.mjs",
    "knowledge:types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck server/knowledge/adapters.d.ts",
    "test:security": "node --test --test-concurrency=1 tests/production-security.test.js tests/security-boundaries.test.js tests/network.test.js tests/security.test.js tests/upload-security.test.js",
    "test:security-services": "node bin/security-services.mjs",
    "runtime:start": "node bin/runtime.mjs",
    "runtime:import": "node bin/runtime.mjs import",
    "test:runtime": "node --test tests/production-runtime.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "bullmq": "6.3.11",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "otpauth": "^9.5.2",
    "pdf-parse": "^2.4.5",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^7.30.0",
    "zod": "^4.6.5",
    "csv-parse": "7.0.3",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "@electric-sql/pglite-pgvector": "0.0.9"
  }
}
